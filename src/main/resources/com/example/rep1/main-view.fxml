<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.rep1.MainController"
      alignment="TOP_CENTER"
      spacing="20.0"
      prefWidth="700.0"
      prefHeight="450.0">

    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <Label text="РИСКОВАННАЯ ШАХТА"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Выберите шахту и попробуйте добыть сокровища"
           style="-fx-font-size: 14px;"/>

    <Separator/>

    <HBox alignment="CENTER" spacing="80.0">

        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Ваш баланс"/>
            <Label fx:id="moneyLabel"
                   text="Баланс: 10"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Добыча экспедиции"/>
            <Label fx:id="lootLabel"
                   text="Добыча: 0"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>

    </HBox>

    <Separator/>

    <Label text="Выберите шахту:"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="20.0">

        <VBox alignment="CENTER"
              spacing="10.0"
              prefWidth="180.0">

            <Label text="Старая шахта"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Низкий риск"/>

            <Label text="Небольшая награда"/>

            <Button text="Копать"
                    prefWidth="140.0"
                    onAction="#onOldMine"/>

        </VBox>

        <VBox alignment="CENTER"
              spacing="10.0"
              prefWidth="180.0">

            <Label text="Глубокая шахта"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Средний риск"/>

            <Label text="Средняя награда"/>

            <Button text="Копать"
                    prefWidth="140.0"
                    onAction="#onDeepMine"/>

        </VBox>

        <VBox alignment="CENTER"
              spacing="10.0"
              prefWidth="180.0">

            <Label text="Заброшенная шахта"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Высокий риск"/>

            <Label text="Большая награда"/>

            <Button text="Копать"
                    prefWidth="140.0"
                    onAction="#onAbandonedMine"/>

        </VBox>

    </HBox>

    <Separator/>

    <VBox alignment="CENTER" spacing="5.0">

        <Label text="Последнее событие:"/>

        <Label fx:id="eventLabel"
               text="Экспедиция ещё не началась"
               style="-fx-font-size: 15px;"/>

    </VBox>

    <Button text="Забрать добычу"
            prefWidth="200.0"
            onAction="#onTakeLoot"/>

</VBox>
